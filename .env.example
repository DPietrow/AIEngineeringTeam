# Copy to backend/.env (never commit .env)
ANTHROPIC_API_KEY=
# auto: use the real API if a key is set, otherwise the free fake LLM. Or force: anthropic | fake
LLM_MODE=auto
LLM_MODEL=claude-haiku-4-5-20251001
# Hard per-run and global spend caps, USD
RUN_SPEND_CAP_USD=1.00
GLOBAL_SPEND_CAP_USD=10.00
# Absolute path to the toy repo the agents modify (a git repo with a "main" branch)
TOY_REPO_PATH=C:/Users/david.pietrow/personal/agentteam-toy
# Where per-run git worktrees are created
WORKSPACES_DIR=data/workspaces
# SQLite path (relative to the directory you start the server/worker from: backend/)
DATABASE_PATH=data/agentteam.db
