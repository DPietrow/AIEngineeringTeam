# Copy to backend/.env (never commit .env)
ANTHROPIC_API_KEY=
# auto: use the real API if a key is set, otherwise the free fake LLM. Or force: anthropic | fake
LLM_MODE=auto
LLM_MODEL=claude-haiku-4-5-20251001
# Per-agent models (optional). An agent with no entry uses LLM_MODEL. Agents: ARCHITECT,
# IMPLEMENTATION, TESTING, REVIEW, DELIVERY. Priced models: claude-haiku-4-5-20251001,
# claude-sonnet-5-5, claude-opus-5-5, claude-fable-5-1 (see pricing.py). Changing these changes
# the run's config hash, so evals can be compared. Raise RUN_SPEND_CAP_USD if you use bigger models.
# MODEL_REVIEW=claude-sonnet-5-5
# MODEL_ARCHITECT=claude-sonnet-5-5
# Prompt caching: reuse the conversation prefix between agent turns at 0.1x the input price.
# Haiku 4.5 only caches prefixes of 4096+ tokens, so short loops see no effect. 0 disables it.
PROMPT_CACHING=1
# Hard per-run and global spend caps, USD
RUN_SPEND_CAP_USD=1.00
GLOBAL_SPEND_CAP_USD=10.00
# Absolute path to the toy repo the agents modify (a git repo with a "main" branch)
TOY_REPO_PATH=C:/Users/david.pietrow/personal/agentteam-toy
# Sandbox for the Testing agent. docker = isolated container (default). local = NO isolation, dev only
SANDBOX_MODE=docker
SANDBOX_IMAGE=agentteam-sandbox:py312
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_TIMEOUT_S=120
# Resilience
# A run that takes longer than this ends "timed_out" (checked between steps, so it can overshoot
# by one step). Typical runs take 1-6 minutes.
RUN_TIMEOUT_S=900
# Transient API failures (429, 5xx, 529 overloaded, dropped connections) are retried with
# exponential backoff and jitter; 4xx client errors are not.
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_DELAY_S=1.0
LLM_TIMEOUT_S=120
# A worker leases the run it is executing and renews every WORKER_LEASE_S/3. If the worker dies,
# the lease expires and the run is recovered (running -> error, delivering -> approved).
WORKER_LEASE_S=60
# Loop caps: a run ends "failed" once exceeded
MAX_TEST_RETRIES=3
MAX_REVIEW_ROUNDS=3
MAX_TESTING_STEPS=8
MAX_REVIEW_STEPS=8
# Delivery: open a GitHub PR after a human approves in the dashboard. Leave GITHUB_TOKEN or
# GITHUB_REPO empty to turn delivery off (a reviewer-approved run then just ends "done").
# Use a FINE-GRAINED token limited to the toy repo: Contents (read/write) + Pull requests
# (read/write), nothing else. The toy repo needs an "origin" remote pointing at GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_REPO=DPietrow/agentteam-toy
GITHUB_BASE_BRANCH=main
MAX_DELIVERY_STEPS=5
# Optional: launch the GitHub MCP server differently (default: official Docker image).
# GITHUB_MCP_COMMAND=docker
# GITHUB_MCP_ARGS=run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN -e GITHUB_TOOLS ghcr.io/github/github-mcp-server
# Where per-run git worktrees are created
WORKSPACES_DIR=data/workspaces
# SQLite path (relative to the directory you start the server/worker from: backend/)
DATABASE_PATH=data/agentteam.db
