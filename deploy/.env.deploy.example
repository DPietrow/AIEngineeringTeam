# Copy to deploy/.env.deploy (git-ignored). Read by deploy/do_cli.py on your computer.
# Create a token at https://cloud.digitalocean.com/account/api/tokens (Custom scope: droplet,
# snapshot, image, ssh_key read, domain if you use DO DNS). Never commit it.
DO_TOKEN=
# Fingerprint(s) of SSH public key(s) already uploaded to DigitalOcean (Settings > Security),
# comma separated. Required for the first (fresh) server.
DO_SSH_KEYS=
# Path to the matching private key if it is not loaded in your ssh agent (optional)
# SSH_IDENTITY=C:/Users/you/.ssh/id_ed25519
DO_REGION=nyc3
DO_SIZE=s-2vcpu-4gb
# Optional. A name whose DNS zone is on DigitalOcean: do_cli updates its A record on every `up`.
# Leave empty to use a free <ip>.sslip.io name instead (works without owning a domain; the name
# changes each time the server's IP changes).
# DO_HOSTNAME=agentteam.example.com
# How many snapshots to keep (older ones are deleted after a successful `down`)
# DO_KEEP_SNAPSHOTS=2
