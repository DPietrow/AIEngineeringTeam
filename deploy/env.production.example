# Server environment: copy to deploy/.env.server (git-ignored), fill in, and `do_cli.py deploy`
# uploads it to /etc/agentteam/env (readable only by root and the agentteam user).
# Never commit the filled-in file.
ANTHROPIC_API_KEY=
LLM_MODE=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
# MODEL_REVIEW=claude-sonnet-5-5
PROMPT_CACHING=1
RUN_SPEND_CAP_USD=1.00
GLOBAL_SPEND_CAP_USD=10.00

# Auth: a deployed API must never be open.
AUTH_REQUIRED=1
API_PASSWORD=
# 32+ random characters, separate from the password:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TRUST_PROXY=1

# Paths on the server (created by provision.sh/release.sh; do not change)
DATABASE_PATH=/var/lib/agentteam/agentteam.db
WORKSPACES_DIR=/var/lib/agentteam/workspaces
TOY_REPO_PATH=/opt/agentteam/toy
SANDBOX_MODE=docker
SANDBOX_IMAGE=agentteam-sandbox:py312

# Delivery (PR behind the approval gate). Fine-grained token, ONE repo, Contents + Pull requests.
GITHUB_TOKEN=
GITHUB_REPO=DPietrow/agentteam-toy
GITHUB_BASE_BRANCH=main
