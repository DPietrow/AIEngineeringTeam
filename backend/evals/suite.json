{
  "name": "toy-notes-v1",
  "cases": [
    {
      "id": "delete-note",
      "task": "Add a DELETE /notes/<id> endpoint that removes a note and returns 204, with tests",
      "acceptance": "acceptance/delete_note.py",
      "difficulty": "easy",
      "reference": [
        {
          "op": "replace",
          "path": "toyapp/store.py",
          "old": "        return list(self._notes.values())",
          "new": [
            "        return list(self._notes.values())",
            "",
            "    def delete(self, id: int) -> bool:",
            "        return self._notes.pop(id, None) is not None"
          ]
        },
        {
          "op": "replace",
          "path": "toyapp/app.py",
          "old": "        return jsonify(store.add(text.strip())), 201",
          "new": [
            "        return jsonify(store.add(text.strip())), 201",
            "",
            "    @app.delete(\"/notes/<int:note_id>\")",
            "    def delete_note(note_id):",
            "        if not store.delete(note_id):",
            "            return jsonify(error=\"note not found\"), 404",
            "        return \"\", 204"
          ]
        },
        {
          "op": "replace",
          "path": "tests/test_app.py",
          "old": "    assert \"error\" in res.get_json()",
          "new": [
            "    assert \"error\" in res.get_json()",
            "",
            "",
            "def test_delete_note(client):",
            "    client.post(\"/notes\", json={\"text\": \"a\"})",
            "    res = client.delete(\"/notes/1\")",
            "    assert res.status_code == 204",
            "    assert res.data == b\"\"",
            "    assert client.get(\"/notes\").get_json() == []",
            "",
            "",
            "def test_delete_missing_note(client):",
            "    res = client.delete(\"/notes/99\")",
            "    assert res.status_code == 404",
            "    assert \"error\" in res.get_json()"
          ]
        }
      ]
    },
    {
      "id": "get-note",
      "task": "Add a GET /notes/<id> endpoint that returns a single note, with tests",
      "acceptance": "acceptance/get_note.py",
      "difficulty": "easy",
      "reference": [
        {
          "op": "replace",
          "path": "toyapp/store.py",
          "old": "        return list(self._notes.values())",
          "new": [
            "        return list(self._notes.values())",
            "",
            "    def get(self, id: int) -> dict | None:",
            "        return self._notes.get(id)"
          ]
        },
        {
          "op": "replace",
          "path": "toyapp/app.py",
          "old": "        return jsonify(store.add(text.strip())), 201",
          "new": [
            "        return jsonify(store.add(text.strip())), 201",
            "",
            "    @app.get(\"/notes/<int:note_id>\")",
            "    def get_note(note_id):",
            "        note = store.get(note_id)",
            "        if note is None:",
            "            return jsonify(error=\"note not found\"), 404",
            "        return jsonify(note)"
          ]
        },
        {
          "op": "replace",
          "path": "tests/test_app.py",
          "old": "    assert \"error\" in res.get_json()",
          "new": [
            "    assert \"error\" in res.get_json()",
            "",
            "",
            "def test_get_note(client):",
            "    client.post(\"/notes\", json={\"text\": \"a\"})",
            "    assert client.get(\"/notes/1\").get_json() == {\"id\": 1, \"text\": \"a\"}",
            "",
            "",
            "def test_get_missing_note(client):",
            "    res = client.get(\"/notes/5\")",
            "    assert res.status_code == 404",
            "    assert \"error\" in res.get_json()"
          ]
        }
      ]
    },
    {
      "id": "count-notes",
      "task": "Add a GET /notes/count endpoint that returns {\"count\": <number of notes>}, with tests",
      "acceptance": "acceptance/count_notes.py",
      "difficulty": "easy",
      "reference": [
        {
          "op": "replace",
          "path": "toyapp/app.py",
          "old": "        return jsonify(store.add(text.strip())), 201",
          "new": [
            "        return jsonify(store.add(text.strip())), 201",
            "",
            "    @app.get(\"/notes/count\")",
            "    def count_notes():",
            "        return jsonify(count=len(store.list()))"
          ]
        }
      ]
    },
    {
      "id": "update-note",
      "task": "Add a PUT /notes/<id> endpoint that replaces a note's text, validating input like the create endpoint does, with tests",
      "acceptance": "acceptance/update_note.py",
      "difficulty": "medium",
      "reference": [
        {
          "op": "replace",
          "path": "toyapp/store.py",
          "old": "        return list(self._notes.values())",
          "new": [
            "        return list(self._notes.values())",
            "",
            "    def update(self, id: int, text: str) -> dict | None:",
            "        note = self._notes.get(id)",
            "        if note is not None:",
            "            note[\"text\"] = text",
            "        return note"
          ]
        },
        {
          "op": "replace",
          "path": "toyapp/app.py",
          "old": "        return jsonify(store.add(text.strip())), 201",
          "new": [
            "        return jsonify(store.add(text.strip())), 201",
            "",
            "    @app.put(\"/notes/<int:note_id>\")",
            "    def update_note(note_id):",
            "        body = request.get_json(silent=True) or {}",
            "        text = body.get(\"text\")",
            "        if not isinstance(text, str) or not text.strip():",
            "            return jsonify(error=\"'text' must be a non-empty string\"), 400",
            "        note = store.update(note_id, text.strip())",
            "        if note is None:",
            "            return jsonify(error=\"note not found\"), 404",
            "        return jsonify(note)"
          ]
        }
      ]
    },
    {
      "id": "search-notes",
      "task": "Make GET /notes accept an optional q query parameter that filters notes by case-insensitive substring match on their text, with tests",
      "acceptance": "acceptance/search_notes.py",
      "difficulty": "medium",
      "reference": [
        {
          "op": "replace",
          "path": "toyapp/app.py",
          "old": "        return jsonify(store.list())",
          "new": [
            "        q = request.args.get(\"q\", \"\").lower()",
            "        return jsonify([n for n in store.list() if q in n[\"text\"].lower()])"
          ]
        }
      ]
    }
  ],
